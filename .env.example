# Token que te da @BotFather al crear el bot
BOT_TOKEN=

# Zona horaria usada para calcular las horas de los recordatorios
# Lista de zonas: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
TZ=Europe/Madrid

# (Opcional) IDs de chat autorizados a usar el bot, separados por comas.
# Si lo dejas vacío, el bot responde a cualquiera que le escriba.
# Para saber tu chat_id, habla con el bot y usa /start: te lo mostrará.
ALLOWED_CHAT_IDS=
